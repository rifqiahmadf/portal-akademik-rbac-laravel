{
	"compilerOptions": {
		"target": "ES2024",
		"lib": ["dom", "dom.iterable", "es2024"],
		"types": ["node", "react", "react-dom"],
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"incremental": true,
		"plugins": [
			{
				"name": "next"
			}
		],
		"paths": {
			"@/*": ["./*"]
		},
		"allowJs": false,
		"esModuleInterop": true
	},
	"include": [
		"next-env.d.ts",
		".next/types/**/*.ts",
		"**/*.ts",
		"**/*.tsx",
		".next/dev/types/**/*.ts"
	],
	"exclude": ["node_modules"]
}
